CREATE TABLE IF NOT EXISTS mom_meetings (
  id INT AUTO_INCREMENT PRIMARY KEY,
  mom_number VARCHAR(50) NOT NULL,
  title VARCHAR(255) NOT NULL,
  meeting_type VARCHAR(50) NOT NULL DEFAULT 'internal',
  meeting_date DATE NOT NULL,
  start_time TIME NULL,
  end_time TIME NULL,
  location VARCHAR(255) DEFAULT '',
  chair VARCHAR(150) DEFAULT '',
  notetaker VARCHAR(150) DEFAULT '',
  status VARCHAR(20) NOT NULL DEFAULT 'draft',
  next_steps TEXT NULL,
  next_meeting_date DATE NULL,
  next_meeting_time TIME NULL,
  next_meeting_location VARCHAR(255) DEFAULT '',
  prepared_by_name VARCHAR(150) DEFAULT '',
  prepared_by_role VARCHAR(150) DEFAULT '',
  prepared_by_date DATE NULL,
  prepared_by_signature LONGTEXT NULL,
  approved_by_name VARCHAR(150) DEFAULT '',
  approved_by_role VARCHAR(150) DEFAULT '',
  approved_by_date DATE NULL,
  approved_by_signature LONGTEXT NULL,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  deleted_at DATETIME NULL,
  INDEX idx_mom_meeting_date (meeting_date),
  INDEX idx_mom_status (status),
  INDEX idx_mom_deleted (deleted_at)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE IF NOT EXISTS mom_attendees (
  id INT AUTO_INCREMENT PRIMARY KEY,
  mom_id INT NOT NULL,
  name VARCHAR(150) NOT NULL DEFAULT '',
  role VARCHAR(150) DEFAULT '',
  organization VARCHAR(150) DEFAULT '',
  attendance VARCHAR(20) NOT NULL DEFAULT 'present',
  sort_order INT NOT NULL DEFAULT 0,
  deleted_at DATETIME NULL,
  INDEX idx_mom_attendees_mom (mom_id),
  CONSTRAINT fk_mom_attendees_meeting FOREIGN KEY (mom_id) REFERENCES mom_meetings(id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE IF NOT EXISTS mom_agenda (
  id INT AUTO_INCREMENT PRIMARY KEY,
  mom_id INT NOT NULL,
  topic VARCHAR(255) NOT NULL DEFAULT '',
  presenter VARCHAR(150) DEFAULT '',
  duration VARCHAR(50) DEFAULT '',
  sort_order INT NOT NULL DEFAULT 0,
  deleted_at DATETIME NULL,
  INDEX idx_mom_agenda_mom (mom_id),
  CONSTRAINT fk_mom_agenda_meeting FOREIGN KEY (mom_id) REFERENCES mom_meetings(id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE IF NOT EXISTS mom_discussions (
  id INT AUTO_INCREMENT PRIMARY KEY,
  mom_id INT NOT NULL,
  agenda_topic VARCHAR(255) DEFAULT '',
  notes TEXT NULL,
  sort_order INT NOT NULL DEFAULT 0,
  deleted_at DATETIME NULL,
  INDEX idx_mom_discussions_mom (mom_id),
  CONSTRAINT fk_mom_discussions_meeting FOREIGN KEY (mom_id) REFERENCES mom_meetings(id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE IF NOT EXISTS mom_decisions (
  id INT AUTO_INCREMENT PRIMARY KEY,
  mom_id INT NOT NULL,
  decision_text TEXT NULL,
  sort_order INT NOT NULL DEFAULT 0,
  deleted_at DATETIME NULL,
  INDEX idx_mom_decisions_mom (mom_id),
  CONSTRAINT fk_mom_decisions_meeting FOREIGN KEY (mom_id) REFERENCES mom_meetings(id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE IF NOT EXISTS mom_action_items (
  id INT AUTO_INCREMENT PRIMARY KEY,
  mom_id INT NOT NULL,
  description TEXT NULL,
  pic VARCHAR(150) DEFAULT '',
  due_date DATE NULL,
  status VARCHAR(20) NOT NULL DEFAULT 'open',
  sort_order INT NOT NULL DEFAULT 0,
  deleted_at DATETIME NULL,
  INDEX idx_mom_actions_mom (mom_id),
  INDEX idx_mom_actions_status (status),
  CONSTRAINT fk_mom_actions_meeting FOREIGN KEY (mom_id) REFERENCES mom_meetings(id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
