# Server
PORT=3000

# Storage mode: json (default) | mysql
# Catatan: fitur Minutes of Meeting saat ini hanya tersedia pada mode json
STORAGE=json

# MySQL (hanya jika STORAGE=mysql; fitur MoM belum didukung di MySQL)
MYSQL_URL=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=db_timepro
