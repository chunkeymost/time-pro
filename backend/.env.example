# Server
PORT=3000

# Storage mode: json (default) | mysql
# Catatan: fitur Minutes of Meeting saat ini hanya tersedia pada mode json
STORAGE=json

# MySQL (hanya jika STORAGE=mysql; fitur MoM belum didukung di MySQL)
MYSQL_URL=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=db_timepro

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Generate nilai acak dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# AUTH_SECRET          : kunci tanda tangan (HMAC) security token sesi
# AUTH_ENCRYPTION_KEY  : kunci enkripsi AES-256-GCM untuk data/auth.json
#
# Jika dikosongkan, server membuat otomatis di data/.auth-secrets.json.
# Untuk produksi, isi di sini dan simpan di secret manager.
AUTH_SECRET=
AUTH_ENCRYPTION_KEY=

# Umur sesi (format: 30m, 8h, 30d). Default 8 jam.
AUTH_TOKEN_TTL=8h
AUTH_REMEMBER_TTL=30d

# Set true jika aplikasi diakses lewat HTTPS (cookie hanya dikirim via HTTPS)
AUTH_COOKIE_SECURE=false

# Batas percobaan login
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW=15m
AUTH_LOGIN_BLOCK=15m

# Origin tambahan yang diizinkan (pisahkan dengan koma), mis. https://timepro.example.com
ALLOWED_ORIGIN=
